# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/healthcare_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15

# --- SendGrid ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourclinic.com
SENDGRID_FROM_NAME=YourClinic

# --- Google OAuth / Calendar ---
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
SLOT_HOLD_MINUTES=5
MAX_EMAIL_RETRY_ATTEMPTS=5
APPOINTMENT_REMINDER_HOURS_BEFORE=24
